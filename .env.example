# Compose-local-only example. Replace with a long random secret before use.
POSTGRES_PASSWORD=change-me-to-a-random-secret
DRAFTLY_SUPER_ADMIN_EMAIL=admin@example.com
DRAFTLY_LLM_MODEL=ollama:gemma4:31b-cloud
DRAFTLY_LLM_BASE_URL=http://host.docker.internal:11434
DRAFTLY_GOOGLE_CLIENT_ID=
DRAFTLY_GOOGLE_CLIENT_SECRET=
DRAFTLY_GMAIL_TOKEN_KEY=
DRAFTLY_GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
DRAFTLY_CORS_ORIGINS=["http://localhost:3000"]
DRAFTLY_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DRAFTLY_COOKIE_SECURE=false
DRAFTLY_REGISTRATION_OPEN=true
DRAFTLY_EMAIL_VERIFICATION_SECRET=replace-with-at-least-32-random-characters
DRAFTLY_EMAIL_SMTP_HOST=smtp.example.com
DRAFTLY_EMAIL_SMTP_PORT=587
DRAFTLY_EMAIL_SMTP_USERNAME=your-smtp-username
DRAFTLY_EMAIL_SMTP_PASSWORD=your-smtp-password
DRAFTLY_EMAIL_SMTP_FROM=Draftly <no-reply@example.com>
DRAFTLY_EMAIL_SMTP_USE_SSL=false
